diff --git a/patches/7.2/0016-pr181-09-media-i2c-ov5693-30-fps-binned-readout-values.patch b/patches/7.2/0016-pr181-09-media-i2c-ov5693-30-fps-binned-readout-values.patch
new file mode 100644
index 0000000..873d37a
--- /dev/null
+++ b/patches/7.2/0016-pr181-09-media-i2c-ov5693-30-fps-binned-readout-values.patch
@@ -0,0 +1,97 @@
+From 77d0f3de6bdcfd844e402feda9a4dc5ad2d4db0a Mon Sep 17 00:00:00 2001
+From: Marco Ziliani <rylos78@gmail.com>
+Date: Fri, 16 Oct 2026 10:05:24 +0200
+Subject: [PATCH 09/10] media: i2c: ov5693: 30 fps binned readout values
+
+With the readout and MIPI PLL values of the 60 fps binned mode, the IPU3
+CIO2 of the Surface Pro 5 loses several frames per stream ("frame sync
+error", payloads of 778 or 831 lines instead of 972). The 30 fps binned
+values (MIPI PLL multiplier 0x7d, analogue 0x3620-0x3622, 0x3708,
+0x3709, 0x371f) stream cleanly: 90 of 90 frames, no errors, through
+libcamera at 640x480.
+
+Use them by default; the module parameter binned_regs selects the old
+set (0) or the 30 fps values with the full-mode PLL (2). Also set 0x4307
+to 0x30 and add a blc_target parameter for the black level target
+(0x4009) for further tuning.
+
+Signed-off-by: Marco Ziliani <rylos78@gmail.com>
+Patchset: cameras
+---
+ drivers/media/i2c/ov5693.c | 40 ++++++++++++++++++++++++++++++++++++--
+ 1 file changed, 38 insertions(+), 2 deletions(-)
+
+diff --git a/drivers/media/i2c/ov5693.c b/drivers/media/i2c/ov5693.c
+index 1d7a9b3..a25b86b 100644
+--- a/drivers/media/i2c/ov5693.c
++++ b/drivers/media/i2c/ov5693.c
+@@ -318,7 +318,7 @@ static const struct cci_reg_sequence ov5693_global_regs[] = {
+ 	{CCI_REG8(0x4009), 0x10},
+ 	{CCI_REG8(0x4058), 0x00},
+ 	{CCI_REG8(0x4101), 0xb2},
+-	{CCI_REG8(0x4307), 0x31},
++	{CCI_REG8(0x4307), 0x30},
+ 	{CCI_REG8(0x4511), 0x05},
+ 	{CCI_REG8(0x4512), 0x01},
+ 	{CCI_REG8(0x481f), 0x30},
+@@ -660,6 +660,33 @@ static const struct cci_reg_sequence ov5693_mode_binned_regs[] = {
+ 	{CCI_REG8(0x371f), 0x1f},
+ };
+ 
++/*
++ * Binned readout set. With the 60 fps values (0) the IPU3 CIO2 of the
++ * Surface Pro 5 loses several frames per stream ("frame sync error",
++ * short payloads); the 30 fps values (1, default) stream cleanly.
++ *   binned_regs = 0: readout and MIPI PLL of the 60 fps binned mode
++ *   binned_regs = 1: 30 fps binned values, MIPI PLL multiplier 0x7d
++ *   binned_regs = 2: 30 fps binned values with the full-mode PLL (0x83)
++ * blc_target: black level target (0x4009); 0 leaves the default.
++ */
++static int binned_regs = 1;
++module_param(binned_regs, int, 0644);
++MODULE_PARM_DESC(binned_regs, "binned readout set (0=60fps, 1=30fps, 2=30fps+full PLL)");
++
++static int blc_target;
++module_param(blc_target, int, 0644);
++MODULE_PARM_DESC(blc_target, "black level target 0x4009 (0=default)");
++
++static const struct cci_reg_sequence ov5693_mode_binned30_regs[] = {
++	{CCI_REG8(0x30b3), 0x7d},	/* MIPI PLL multiplier */
++	{CCI_REG8(0x3620), 0x54},
++	{CCI_REG8(0x3621), 0xc7},
++	{CCI_REG8(0x3622), 0x0f},
++	{CCI_REG8(0x3708), 0xe6},
++	{CCI_REG8(0x3709), 0xc7},
++	{CCI_REG8(0x371f), 0x0c},
++};
++
+ static int ov5693_mode_configure(struct ov5693_device *ov5693)
+ {
+ 	const struct ov5693_mode *mode = &ov5693->mode;
+@@ -762,13 +789,22 @@ static int ov5693_mode_configure(struct ov5693_device *ov5693)
+ 				ov5693_flip_vert_bits(ov5693), &ret);
+ 
+ 	/* PLL and analogue readout timing follow the readout mode. */
+-	if (mode->binning_x || mode->binning_y)
++	if ((mode->binning_x || mode->binning_y) && binned_regs) {
++		cci_multi_reg_write(ov5693->regmap, ov5693_mode_binned30_regs,
++				    ARRAY_SIZE(ov5693_mode_binned30_regs), &ret);
++		if (binned_regs == 2)
++			cci_write(ov5693->regmap, CCI_REG8(0x30b3), 0x83, &ret);
++	} else if (mode->binning_x || mode->binning_y)
+ 		cci_multi_reg_write(ov5693->regmap, ov5693_mode_binned_regs,
+ 				    ARRAY_SIZE(ov5693_mode_binned_regs), &ret);
+ 	else
+ 		cci_multi_reg_write(ov5693->regmap, ov5693_mode_full_regs,
+ 				    ARRAY_SIZE(ov5693_mode_full_regs), &ret);
+ 
++	if (blc_target)
++		cci_write(ov5693->regmap, CCI_REG8(0x4009), blc_target & 0xff,
++			  &ret);
++
+ 	return ret;
+ }
+ 
+-- 
+2.43.0
+
diff --git a/patches/7.2/0016-pr181-10-media-i2c-ov7251-Surface-IR-strobe-pulse-follows-the.patch b/patches/7.2/0016-pr181-10-media-i2c-ov7251-Surface-IR-strobe-pulse-follows-the.patch
new file mode 100644
index 0000000..c2b62c9
--- /dev/null
+++ b/patches/7.2/0016-pr181-10-media-i2c-ov7251-Surface-IR-strobe-pulse-follows-the.patch
@@ -0,0 +1,78 @@
+From 76d2ae0226af8d6b233e90fa35b154cf0be842e3 Mon Sep 17 00:00:00 2001
+From: Marco Ziliani <rylos78@gmail.com>
+Date: Fri, 16 Oct 2026 10:05:46 +0200
+Subject: [PATCH 10/10] media: i2c: ov7251: Surface IR strobe pulse follows the
+ exposure
+
+Signed-off-by: Marco Ziliani <rylos78@gmail.com>
+Patchset: cameras
+---
+ drivers/media/i2c/ov7251.c | 32 +++++++++++++++++++++++++++++++-
+ 1 file changed, 31 insertions(+), 1 deletion(-)
+
+diff --git a/drivers/media/i2c/ov7251.c b/drivers/media/i2c/ov7251.c
+index 14133dc..a15df17 100644
+--- a/drivers/media/i2c/ov7251.c
++++ b/drivers/media/i2c/ov7251.c
+@@ -285,6 +285,18 @@ static const struct reg_value ov7251_surface_ir_strobe_regs[] = {
+ 	{ 0x3b96, 0xc0 },
+ };
+ 
++/*
++ * Strobe pattern (0x3b81): 0xaa lights alternate frames, 0xff every frame.
++ * The strobe pulse follows the exposure time (0x3b8c-0x3b8f, in lines),
++ * clamped to the range the Surface uses.
++ */
++static int surface_ir_pattern = 0xaa;
++module_param(surface_ir_pattern, int, 0644);
++MODULE_PARM_DESC(surface_ir_pattern, "IR strobe pattern 0x3b81 (0xaa alternate frames, 0xff every frame)");
++
++#define OV7251_STROBE_MIN_LINES		52
++#define OV7251_STROBE_MAX_LINES		776
++
+ static bool ov7251_use_surface_ir_strobe(void)
+ {
+ 	if (surface_ir_strobe >= 0)
+@@ -924,13 +936,28 @@ static int ov7251_set_exposure(struct ov7251 *ov7251, s32 exposure)
+ {
+ 	u16 reg;
+ 	u8 val[3];
++	s32 strobe;
++	int ret;
+ 
+ 	reg = OV7251_AEC_EXPO_0;
+ 	val[0] = (exposure & 0xf000) >> 12; /* goes to OV7251_AEC_EXPO_0 */
+ 	val[1] = (exposure & 0x0ff0) >> 4;  /* goes to OV7251_AEC_EXPO_1 */
+ 	val[2] = (exposure & 0x000f) << 4;  /* goes to OV7251_AEC_EXPO_2 */
+ 
+-	return ov7251_write_seq_regs(ov7251, reg, val, 3);
++	ret = ov7251_write_seq_regs(ov7251, reg, val, 3);
++	if (ret < 0 || !ov7251_use_surface_ir_strobe())
++		return ret;
++
++	strobe = clamp_t(s32, exposure, OV7251_STROBE_MIN_LINES,
++			 OV7251_STROBE_MAX_LINES);
++	val[0] = 0;
++	val[1] = 0;
++	val[2] = strobe >> 8;
++	ret = ov7251_write_seq_regs(ov7251, 0x3b8c, val, 3);
++	if (ret < 0)
++		return ret;
++
++	return ov7251_write_reg(ov7251, 0x3b8f, strobe & 0xff);
+ }
+ 
+ static int ov7251_set_gain(struct ov7251 *ov7251, s32 gain)
+@@ -1425,6 +1452,9 @@ static int ov7251_s_stream(struct v4l2_subdev *subdev, int enable)
+ 			ret = ov7251_set_register_array(ov7251,
+ 					ov7251_surface_ir_strobe_regs,
+ 					ARRAY_SIZE(ov7251_surface_ir_strobe_regs));
++			if (!ret)
++				ret = ov7251_write_reg(ov7251, 0x3b81,
++						       surface_ir_pattern & 0xff);
+ 			if (ret < 0) {
+ 				dev_err(ov7251->dev, "could not set IR strobe\n");
+ 				goto err_power_down;
+-- 
+2.43.0
+
